    "Cultural and regional lessons are being checked by native speakers before they appear here. The course content you already have is unaffected.": {
      "localizations": {
        "sq": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mësimet kulturore dhe krahinore po kontrollohen nga folës amtarë përpara se të shfaqen këtu. Përmbajtja e kursit që ke tashmë nuk preket."
          }
        }
      }
    },

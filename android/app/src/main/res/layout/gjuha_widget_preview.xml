<?xml version="1.0" encoding="utf-8"?>
<!--
  What the picker shows before the widget is placed.

  It is a static illustration, not live data: the picker renders it without
  running the widget, so the figures here are an example. They are chosen to
  look like a real learner rather than a row of zeros, which would read as a
  broken widget.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_preview_streak"
            android:textColor="#AA4300"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_xp"
            android:textColor="#1A1A1E" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/widget_preview_today"
        android:textColor="#1A1A1E"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/widget_preview_due"
        android:textColor="#B8221C" />
</LinearLayout>

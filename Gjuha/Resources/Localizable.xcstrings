          }
        }
      }
    },
    "A full week": {
      "comment": "Achievement title: seven consecutive study days.",
      "localizations": {
        "sq": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Një javë e plotë"
          }
        }
      }
    },
    "A gentle nudge once a day. Off by default.": {
      "localizations": {
        "sq": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Një kujtesë e lehtë një herë në ditë. Si parazgjedhje është e çaktivizuar."
          }
        }
      }
    },
    "A hundred words": {
      "comment": "Achievement title: 100 distinct words met.",
      "localizations": {
        "sq": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Njëqind fjalë"
          }
        }
      }
    },
    "A month of Albanian": {
      "comment": "Achievement title: thirty consecutive study days.",
      "localizations": {
        "sq": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Një muaj shqip"
          }
        }
      }
    },
    "A tailored AI explanation is available on this device.": {
      "localizations": {
        "sq": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Në këtë pajisje ofrohet një shpjegim i përshtatur me AI."
          }
        }
      }
    },
    "AI generated": {
      "localizations": {
        "sq": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gjeneruar nga AI"
          }
        }
      }
    },
    "Accuracy": {
      "comment": "Label of the accuracy tile on the completion screen.",
      "localizations": {
        "sq": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Saktësia"
          }
        }
      }
    },
    "Achievements": {
      "comment": "Section heading on the Profile screen.",
      "localizations": {
        "sq": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Arritjet"
          }
        }
      }
    },
    "All": {
      "comment": "CEFR filter chip meaning every level.",
      "localizations": {
        "sq": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Të gjitha"
          }
        }
      }
    },
    "Almost, check the spelling": {
      "localizations": {
        "sq": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pothuajse, kontrollo drejtshkrimin"
          }
        }
      }
    },
    "Answer": {
      "comment": "Label above the typed answer field.",
      "localizations": {
        "sq": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Përgjigjja"
          }
        }
      }
    },
    "Answer: %@": {
      "comment": "%@ is the correct Albanian answer and stays untranslated.",
      "localizations": {
        "sq": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Përgjigjja: %@"
          }
        }
      }
    },
    "Ask a question about this grammar topic": {
      "localizations": {
        "sq": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bëj një pyetje për këtë temë gramatikore"
          }
        }
      }
    },
    "Ask about this topic (optional)": {
      "localizations": {
        "sq": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pyet për këtë temë (opsionale)"
          }
        }
      }
    },
    "Audio is added once a native speaker records it. No machine voice is used for Albanian.": {
      "localizations": {
        "sq": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Audioja shtohet pasi ta regjistrojë një folës amtar. Për shqipen nuk përdoret zë i gjeneruar."
          }
        }
      }
    },
    "Back to lessons": {
      "localizations": {
        "sq": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kthehu te mësimet"
          }
        }
      }
    },
    "Best combo: %lldx": {
      "localizations": {
        "sq": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kombinimi më i mirë: %lldx"
          }

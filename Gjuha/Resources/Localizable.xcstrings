    "You are on a %lld day streak, with %lld words due for review.": {
      "comment": "Two counts: days then words. Only the word count inflects.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are on a %lld day streak, with %#@words@ due for review."
          },
          "substitutions": {
            "words": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg word"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg words"
                    }
                  }
                }
              }
            }
          }
        },
        "sq": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jeni në %lld ditë rresht, me %#@words@ për përsëritje."
          },
          "substitutions": {
            "words": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "needs_review",
                      "value": "%arg fjalë"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "needs_review",
                      "value": "%arg fjalë"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },

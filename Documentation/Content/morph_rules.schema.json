    "noun_patterns",
    "verb_patterns",
    "notes"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "noun_patterns": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "verb_patterns": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "notes": {
      "type": "string"
    }
  }
}